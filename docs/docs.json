{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "CassetteCat",
  "description": "How to use CassetteCat, the music player for the music you own, on Android and on your computer.",
  "colors": {
    "primary": "#C23B30",
    "light": "#D64337",
    "dark": "#C23B30"
  },
  "favicon": "/favicon.ico",
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "fonts": {
    "heading": {
      "family": "Space Grotesk"
    },
    "body": {
      "family": "IBM Plex Sans"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://cassettecat.caffeinelabs.in"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/samyyy2311/CassetteCat"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Download",
      "href": "https://cassettecat.caffeinelabs.in/#download"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Overview",
        "icon": "house",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "index",
              "phone-and-computer"
            ]
          }
        ]
      },
      {
        "tab": "Android",
        "icon": "smartphone",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "android/getting-started"
            ]
          },
          {
            "group": "Using the app",
            "pages": [
              "android/library-and-playlists",
              "android/playback-and-sound",
              "android/streaming-and-radio",
              "android/listening-room",
              "android/car-widgets-shortcuts",
              "android/backup-and-privacy"
            ]
          },
          {
            "group": "Help",
            "pages": [
              "android/troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "Desktop",
        "icon": "monitor",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "desktop/getting-started"
            ]
          },
          {
            "group": "Using the app",
            "pages": [
              "desktop/library-and-playlists",
              "desktop/playback-and-sound",
              "desktop/streaming-and-radio",
              "desktop/settings-and-privacy"
            ]
          },
          {
            "group": "Help",
            "pages": [
              "desktop/troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "Developers",
        "icon": "code",
        "groups": [
          {
            "group": "Developers",
            "pages": [
              "developers/index"
            ]
          },
          {
            "group": "Android",
            "pages": [
              "developers/android/building",
              "developers/android/architecture",
              "developers/android/how-to",
              "developers/android/theme",
              "developers/android/desktop-remote-protocol",
              "developers/android/releasing"
            ]
          },
          {
            "group": "Desktop",
            "pages": [
              "developers/desktop/building",
              "developers/desktop/architecture",
              "developers/desktop/design",
              "developers/desktop/releasing"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/samyyy2311/CassetteCat"
    }
